generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Warga {
  id          Int             @id @default(autoincrement())
  no_kartu    String          @db.VarChar(50)
  nama_kk     String          @db.VarChar(255)
  jumlah_jiwa Int             @default(1)
  created_by  Int
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  iuran_bulanan IuranBulanan[]
  iuran_makam   IuranMakam?
  creator       Users         @relation(fields: [created_by], references: [id])

  @@unique([no_kartu, created_by])
  @@map("warga")
}

model IuranBulanan {
  id           Int      @id @default(autoincrement())
  warga_id     Int
  bulan        Int      @db.SmallInt
  tahun        Int
  jumlah_bayar Decimal  @db.Decimal(12, 2)
  tanggal_bayar DateTime
  status       String   @default("Belum Lunas") @db.VarChar(20)
  dicatat_oleh Int
  created_at   DateTime @default(now())

  warga  Warga @relation(fields: [warga_id], references: [id], onDelete: Cascade)
  user   Users @relation(fields: [dicatat_oleh], references: [id])

  @@unique([warga_id, bulan, tahun])
  @@map("iuran_bulanan")
}

model IuranMakam {
  id               Int             @id @default(autoincrement())
  warga_id         Int             @unique
  total_tagihan    Decimal         @db.Decimal(12, 2)
  tagihan_per_bulan Decimal        @default(0) @db.Decimal(12, 2)
  jangka_waktu     Int             @default(36)
  tanggal_mulai    DateTime        @default(now())
  total_terbayar   Decimal         @default(0) @db.Decimal(12, 2)
  updated_at       DateTime        @updatedAt

  warga    Warga               @relation(fields: [warga_id], references: [id], onDelete: Cascade)
  bulanan  IuranMakamBulanan[]

  @@map("iuran_makam")
}

model IuranMakamBulanan {
  id             Int      @id @default(autoincrement())
  iuran_makam_id Int
  bulan          Int      @db.SmallInt
  tahun          Int
  jumlah_bayar   Decimal  @db.Decimal(12, 2)
  tanggal_bayar  DateTime
  dicatat_oleh   Int
  created_at     DateTime @default(now())

  iuran_makam IuranMakam @relation(fields: [iuran_makam_id], references: [id], onDelete: Cascade)
  user        Users      @relation(fields: [dicatat_oleh], references: [id])

  @@unique([iuran_makam_id, bulan, tahun])
  @@map("iuran_makam_bulanan")
}

model Users {
  id            Int             @id @default(autoincrement())
  username      String          @unique @db.VarChar(100)
  password_hash String
  nama_lengkap  String          @db.VarChar(255)
  role          String          @default("pengurus") @db.VarChar(20)
  created_at    DateTime        @default(now())

  iuran_bulanan       IuranBulanan[]
  iuran_makam_bulanan IuranMakamBulanan[]
  warga               Warga[]

  @@map("users")
}

model Settings {
  key        String   @id @db.VarChar(100)
  value      String
  updated_at DateTime @updatedAt

  @@map("settings")
}
